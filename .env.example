OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional. Override default browser login state files.
JOB_AGENT_AUTH_DIR=

# Optional. BOSS cookie header fallback: key=value; key2=value2
BOSS_COOKIES=

# Required for the formal knowledge graph module.
# Start local Neo4j with: docker compose -f docker-compose.neo4j.yml up -d
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=jobagent123456
NEO4J_DATABASE=neo4j
